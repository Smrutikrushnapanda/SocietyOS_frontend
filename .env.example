# SocietyOS Frontend — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:5050

# Feature flags
NEXT_PUBLIC_FEATURE_COMPLAINTS_ENABLED=true
NEXT_PUBLIC_FEATURE_NOTICES_ENABLED=true
NEXT_PUBLIC_FEATURE_POLLS_ENABLED=true
NEXT_PUBLIC_FEATURE_VISITOR_PASSES_ENABLED=true

# Application
NEXT_PUBLIC_APP_NAME=SocietyOS
NEXT_PUBLIC_APP_VERSION=1.0.0

# Firebase Web Push (frontend only — public values safe for browser bundle)
# Obtain from Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Obtain from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
